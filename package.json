{
  "name": "videokit-clone",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "description": "纯前端在线视频工具箱 - 基于 WebCodecs + ffmpeg.wasm，所有处理在浏览器本地完成",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "version:patch": "npm version patch --no-git-tag-version && node scripts/update-version.js",
    "version:minor": "npm version minor --no-git-tag-version && node scripts/update-version.js",
    "version:major": "npm version major --no-git-tag-version && node scripts/update-version.js",
    "release": "node scripts/release.js",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=videokit --branch=main"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "mediabunny": "^1.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
